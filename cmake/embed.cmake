# Turns build/shaders/*.spv into one C++ file: `const EmbeddedShader* embedded_shader(const char* name)`.
set(body "// generated by cmake/embed.cmake — do not edit\n#include \"embedded_shaders.hpp\"\n#include <cstring>\n")
set(table "")
foreach(name IN LISTS NAMES)
  string(MAKE_C_IDENTIFIER ${name} ident)
  file(READ ${SPV_DIR}/${name}.spv hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR bytes "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  string(APPEND body "static const unsigned char ${ident}_data[] alignas(4) = {${arr}};\n")
  string(APPEND table "  {\"${name}\", ${ident}_data, ${bytes}},\n")
endforeach()
string(APPEND body "static const EmbeddedShader kTable[] = {\n${table}};\n")
string(APPEND body "const EmbeddedShader* embedded_shader(const char* name) {\n  for (const auto& e : kTable) if (std::strcmp(e.name, name) == 0) return &e;\n  return nullptr;\n}\n")
file(WRITE ${OUT} "${body}")
